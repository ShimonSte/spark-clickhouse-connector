# ClickHouse Cloud Test Configuration
# Copy this file to .env and fill in your credentials

# Required for Cloud tests
CLICKHOUSE_CLOUD_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_CLOUD_HTTP_PORT=8443
CLICKHOUSE_CLOUD_TCP_PORT=9000
CLICKHOUSE_CLOUD_USER=default
CLICKHOUSE_CLOUD_PASSWORD=your-password

# Optional: Override local ClickHouse settings
# CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:23.8
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=
