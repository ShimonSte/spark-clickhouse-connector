  case (tz @ _) if tz.==(null).||(tz.isEmpty()).||(tz.toLowerCase().==("server")) => {
    val timezoneOutput: com.clickhouse.spark.format.SimpleOutput[com.fasterxml.jackson.databind.node.ObjectNode] = {
      <artifact> val qual$2: com.clickhouse.spark.client.NodeClient = this.nodeClient;
