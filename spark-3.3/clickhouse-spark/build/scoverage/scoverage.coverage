    scala.Predef.assert(timezoneOutput.rows.==(1));
    val serverTz: java.time.ZoneId = java.time.ZoneId.of(timezoneOutput.records.head.get("tz").asText());
    ClickHouseCatalog.this.log.info(scala.StringContext.apply("Detect ClickHouse server timezone: ", "").s(serverTz));
    scala.`package`.Left.apply[java.time.ZoneId, Nothing](serverTz)
  }
  case (tz @ _) if tz.toLowerCase().==("client") => scala.`package`.Right.apply[Nothing, java.time.ZoneId](java.time.ZoneId.systemDefault())
  case (tz @ _) => scala.`package`.Right.apply[Nothing, java.time.ZoneId](java.time.ZoneId.of(tz))
