{
  val cluster: String = clusterOpt.getOrElse[String]("default");
  val shardExpr: String = props.getOrElse[String]("shard_by", "rand()");
  val settingsClause: String = tblSettingsClause("settings.");
  val localEngineExpr: String = props.getOrElse[String](scala.StringContext.apply("", "engine").s(keyPrefix), scala.StringContext.apply("MergeTree()").s());
  val localDatabase: String = props.getOrElse[String](scala.StringContext.apply("", "database").s(keyPrefix), db);
  val localTable: String = props.getOrElse[String](scala.StringContext.apply("", "table").s(keyPrefix), scala.StringContext.apply("", "_local").s(tbl));
  val localSettingsClause: String = tblSettingsClause(scala.StringContext.apply("", "settings.").s(keyPrefix));
  createTable(scala.Some.apply[String](cluster), localEngineExpr, localDatabase, localTable, localSettingsClause);
  createDistributedTable(cluster, shardExpr, localDatabase, localTable, db, tbl, settingsClause)
}

